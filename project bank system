vector <string> Splitstring (string s1,string Delim="#//#")
{

    short pos=0;
    short count=0;
    string words;
    vector <string> VWords;
    while((pos=s1.find(Delim))!=s1.npos)
    {
        words=s1.substr(0,pos);
        VWords.push_back(words);
        s1.erase(0,pos+Delim.length());
    }

    if(s1!="")
    {
        VWords.push_back(s1);
    }
    return VWords;

}
StClient ConvertLineToRecord (string line)
{
  StClient Client;
  vector <string> VClient= Splitstring(line);

  Client.AccountBalance=stod(VClient[4]);
  Client.phone=VClient[3];
  Client.pincode=VClient[2];
  Client.AccountNum=VClient[1];
  Client.name=VClient[0];

  return Client;
}
vector <StClient> LodadDatatFromFile ()
{

   vector <StClient> StVClient;
   fstream myfile;
   myfile.open(FileName, ios::in);

   if(myfile.is_open())
   {
       string line;
       StClient Client;

       while(getline(myfile,line))
       {
          Client= ConvertLineToRecord(line);
          StVClient.push_back(Client);
       }
   }

    return StVClient;
}
