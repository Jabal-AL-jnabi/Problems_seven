string linedata(StClient client,string dalim="#//#")
{
    string linedata;

    linedata+=client.name+dalim;
    linedata+=client.AccountNum+dalim;
    linedata+=client.pincode+dalim;
    linedata+=client.phone+dalim;
    linedata+=to_string(client.AccountBalance);

   return linedata; 
}
vector <string> Splitstring (string s1,string Delim)
{

    short pos=0;
    short count=0;
    string words;
    vector <string> VWords;
    while((pos=s1.find(Delim))!=s1.npos)
    {
        words=s1.substr(0,pos);
        VWords.push_back(words);
        s1.erase(0,pos+Delim.length());
    }

    if(s1!="")
    {
        VWords.push_back(s1);
    }
    return VWords;

}
